{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VV Code Dev",
  "identifier": "com.vvcode.desktop.dev",
  "build": {
    "devUrl": "http://127.0.0.1:3001",
    "beforeDevCommand": "pnpm dev:renderer:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VV Code Dev",
        "titleBarStyle": "Overlay",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  }
}
